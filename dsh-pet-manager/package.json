{
  "name": "dsh-pet-manager",
  "version": "0.1.0",
  "description": "给 dsh-pet 桌宠引擎做管理的插件：列出已装宠物包、启用/停用、删除与导入。不含任何渲染与动画——那些属于 dsh-pet 本体。",
  "icon": "assets/logo.png",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "desktop-pet", "pet-manager", "cordis"],
  "homepage": "https://github.com/zoudingyun/dsh-pet-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoudingyun/dsh-pet-manager.git"
  },
  "bugs": {
    "url": "https://github.com/zoudingyun/dsh-pet-manager/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "assets/logo.png", "cordis.patch.yml"],
  "scripts": {
    "bundle": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  }
}
